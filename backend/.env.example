# ── Configuración de Base de Datos (PostgreSQL / Supabase) ───────────────
# En Local Docker: postgresql://admin:password123@localhost:5432/estilo_nordico
# En Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://admin:password123@localhost:5432/estilo_nordico

# ── Seguridad y Autenticación JWT ────────────────────────────────────────
# IMPORTANTE: En producción genera una clave segura (ej: openssl rand -hex 32)
SECRET_KEY=cambiar_por_una_clave_secreta_super_segura_de_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Contraseña semilla inicial si la BD está vacía (Solo se usa la primera vez)
ADMIN_DEFAULT_PASSWORD=admin123

# ── Configuración de CORS ────────────────────────────────────────────────
# Dominios permitidos separados por comas. Usa * para desarrollo local.
# En producción: https://tu-tienda.vercel.app,https://tu-erp.vercel.app
ALLOWED_ORIGINS=*

# ── Redis / Caché (Opcional) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
